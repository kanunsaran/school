PORT=3000
# when running outside Docker use 127.0.0.1; docker-compose overrides this with host.docker.internal
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=project_rm
JWT_SECRET=change_me_secret
CORS_ORIGIN=http://localhost:5173

# ส่งอีเมลแจ้งนัดหมาย (ไม่ใส่ = ไม่ส่งอีเมล ระบบอื่นทำงานปกติ)
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=อีเมล Gmail SMTP_PASS=App Password 16 ตัว (ต้องเปิดยืนยัน 2 ขั้นตอนก่อน)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# ลิงก์เว็บที่แนบในอีเมล เช่น https://โดเมนของโรงเรียน
APP_URL=

# ส่งอีเมลแจ้งนัดจาก Gmail ของครูแต่ละคน (ครูกด "เชื่อมต่อ Gmail" ในหน้าปฏิทิน)
# ใช้ OAuth Client เดียวกับปุ่มล็อกอิน Google + เปิด Gmail API ใน Google Cloud • ไม่ใส่ = ไม่แสดงปุ่มเชื่อมต่อ
GOOGLE_CLIENT_SECRET=
# กุญแจเข้ารหัสสิทธิ์ Gmail ที่เก็บในฐานข้อมูล (ไม่ใส่ = ใช้ JWT_SECRET) — ห้ามเปลี่ยนหลังครูเชื่อมต่อแล้ว ไม่งั้นต้องเชื่อมใหม่ทุกคน
MAIL_TOKEN_KEY=

# ตรวจงานด้วย AI (Claude Haiku 4.5) ในหน้าครูตรวจงาน — ไม่ใส่ = ปุ่มตรวจด้วย AI จะแจ้งว่ายังไม่ได้ตั้งค่า ระบบอื่นทำงานปกติ
# สร้าง key ที่ https://console.anthropic.com • เก็บไว้ฝั่ง backend เท่านั้น ห้ามใส่ใน frontend
ANTHROPIC_API_KEY=

# ตรวจงานด้วย AI ผ่าน Cloudflare Workers AI (มีโควตาฟรี 10,000 Neurons/วัน ≈ 40 งาน/วัน, ไม่นำข้อมูลไปฝึกโมเดล)
# dash.cloudflare.com → AI → Workers AI → Use REST API → Create a Workers AI API Token แล้ว copy Account ID + Token
# ตั้งไว้ = ปุ่ม "ตรวจด้วย AI" ใช้ Cloudflare ก่อน Claude • AI_PROVIDER=claude ถ้าต้องการบังคับใช้ Claude
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_PROVIDER=
