// โหลดภาพจากโฟลเดอร์ screens-v2 ใน Google Drive
function imageLoader() {
  const folders = DriveApp.getFoldersByName(FOLDER_NAME);
  if (!folders.hasNext()) throw new Error('ไม่พบโฟลเดอร์ "' + FOLDER_NAME + '" ใน Google Drive — อัปโหลดโฟลเดอร์ screens-v2 ขึ้น My Drive ก่อน');
  const folder = folders.next();
  return (name) => {
    const files = folder.getFilesByName(name);
    if (!files.hasNext()) throw new Error('ไม่พบไฟล์ภาพ ' + name + ' ในโฟลเดอร์ ' + FOLDER_NAME);
    return files.next().getBlob();
  };
}

// เปลี่ยนภาพในฟอร์มที่สร้างไว้แล้ว (คำถามและการแก้ไขอื่นในฟอร์มยังอยู่เหมือนเดิม)
// ใช้: ใส่ลิงก์แก้ไขฟอร์มที่ FORM_EDIT_URL ด้านบน → เลือกฟังก์ชัน updateImages → Run
function updateImages() {
  if (!/^https:\/\/docs\.google\.com\/forms\//.test(FORM_EDIT_URL)) throw new Error('ใส่ลิงก์แก้ไขฟอร์มที่ FORM_EDIT_URL ก่อน (ลิงก์ที่ได้ตอนสร้างฟอร์ม ลงท้ายด้วย /edit)');
  const image = imageLoader();
  const form = FormApp.openByUrl(FORM_EDIT_URL);
  TASKS.forEach((t) => {
    const items = form.getItems();
    const hIdx = items.findIndex((it) => it.getType() === FormApp.ItemType.SECTION_HEADER && it.getTitle() === t.title);
    if (hIdx < 0) { Logger.log('ข้าม: ไม่พบหัวข้อ "' + t.title + '" (อาจถูกเปลี่ยนชื่อ)'); return; }
    // ลบภาพเดิมที่อยู่ถัดจากหัวข้อ
    for (let i = hIdx + 1; i < items.length && items[i].getType() === FormApp.ItemType.IMAGE; i++) form.deleteItem(items[i]);
    // ใส่ภาพใหม่ต่อจากหัวข้อ
    t.images.forEach(([file, caption], k) => {
      const item = form.addImageItem().setTitle(caption).setImage(image(file)).setAlignment(FormApp.Alignment.CENTER);
      form.moveItem(item.getIndex(), hIdx + 1 + k);
    });
    Logger.log('เปลี่ยนภาพแล้ว: ' + t.title + ' (' + t.images.length + ' ภาพ)');
  });
  Logger.log('เสร็จแล้ว เปิดดูฟอร์ม: ' + FORM_EDIT_URL);
}

function createSurvey() {
  const image = imageLoader();

  const form = FormApp.create('แบบสอบถามความพึงพอใจต่อต้นแบบเว็บแนะแนวการศึกษาต่อ (Guidance KKW)');
  form.setDescription(
    'แบบสอบถามนี้จัดทำขึ้นเพื่อประเมินความพึงพอใจของนักเรียนต่อต้นแบบเว็บไซต์แนะแนวการศึกษาต่อ Guidance KKW ' +
    'โรงเรียนขอนแก่นวิทยายน ซึ่งเป็นส่วนหนึ่งของโครงงาน\n\n' +
    'คำชี้แจง\n' +
    '• แบบสอบถามมี 4 ตอน: (1) ข้อมูลทั่วไป (2) ทดสอบการใช้งานแต่ละส่วนของระบบ (3) ความพึงพอใจภาพรวม (4) ข้อเสนอแนะ\n' +
    '• ในตอนที่ 2 ให้ลองทำ "ภารกิจ" บนเว็บไซต์จริงก่อน แล้วจึงตอบคำถามของส่วนนั้น\n' +
    '• ระดับความพึงพอใจ: 5 = มากที่สุด, 4 = มาก, 3 = ปานกลาง, 2 = น้อย, 1 = น้อยที่สุด\n' +
    '• ไม่ต้องระบุชื่อ คำตอบจะนำไปใช้เพื่อปรับปรุงระบบเท่านั้น ใช้เวลาประมาณ 10–15 นาที'
  );
  form.setProgressBar(true);
  form.setCollectEmail(false);
  form.setConfirmationMessage('ขอบคุณที่ช่วยทดสอบและประเมินระบบ Guidance KKW คำตอบของคุณช่วยให้ระบบดีขึ้น');

  // ตอนที่ 1
  form.addSectionHeaderItem().setTitle('ตอนที่ 1 ข้อมูลทั่วไปของผู้ตอบแบบสอบถาม');
  form.addMultipleChoiceItem().setTitle('เพศ').setChoiceValues(['ชาย', 'หญิง', 'ไม่ประสงค์ระบุ']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('ระดับชั้น').setChoiceValues(['ม.4', 'ม.5', 'ม.6']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('แผนการเรียน').setChoiceValues(['วิทย์-คณิต', 'ศิลป์-คำนวณ', 'ศิลป์-ภาษา']).showOtherOption(true).setRequired(true);
  form.addMultipleChoiceItem().setTitle('อุปกรณ์ที่ใช้ทดสอบระบบ').setChoiceValues(['โทรศัพท์มือถือ', 'แท็บเล็ต', 'คอมพิวเตอร์/โน้ตบุ๊ก']).setRequired(true);
  form.addMultipleChoiceItem().setTitle('เคยใช้เว็บไซต์/แอปเกี่ยวกับการศึกษาต่อมาก่อนหรือไม่ (เช่น myTCAS)').setChoiceValues(['เคย', 'ไม่เคย']).setRequired(true);

  // ตอนที่ 2
  form.addPageBreakItem().setTitle('ตอนที่ 2 ทดสอบการใช้งานแต่ละส่วนของระบบ')
    .setHelpText('ดูภาพหน้าจอ แล้วลองทำภารกิจบนเว็บไซต์จริง จากนั้นตอบว่าทำได้หรือไม่ และให้คะแนนความพึงพอใจ');
  TASKS.forEach((t, i) => {
    if (i > 0) form.addPageBreakItem().setTitle('ตอนที่ 2 (ต่อ)');
    form.addSectionHeaderItem().setTitle(t.title).setHelpText(t.task);
    t.images.forEach(([file, caption]) => form.addImageItem().setTitle(caption).setImage(image(file)).setAlignment(FormApp.Alignment.CENTER));
    form.addMultipleChoiceItem().setTitle('ผลการทำภารกิจ: ' + t.title.replace(/^[\d.]+\s*/, '')).setChoiceValues(TASK_RESULT).setRequired(true);
    form.addGridItem().setTitle('ความพึงพอใจต่อ' + t.title.replace(/^[\d.]+\s*/, '')).setRows(t.items).setColumns(SCALE).setRequired(true);
    form.addParagraphTextItem().setTitle('ปัญหาที่พบ / สิ่งที่อยากให้ปรับปรุงในส่วนนี้ (ถ้ามี)');
  });

  // ตอนที่ 3
  form.addPageBreakItem().setTitle('ตอนที่ 3 ความพึงพอใจต่อระบบโดยภาพรวม')
    .setHelpText('ให้คะแนนจากประสบการณ์การใช้งานทั้งระบบ');
  OVERALL.forEach(([title, rows], i) => form.addGridItem().setTitle(`3.${i + 1} ${title}`).setRows(rows).setColumns(SCALE).setRequired(true));

  // ตอนที่ 4
  form.addPageBreakItem().setTitle('ตอนที่ 4 ข้อเสนอแนะ');
  form.addScaleItem().setTitle('คุณจะแนะนำเว็บไซต์นี้ให้เพื่อนใช้มากน้อยเพียงใด').setBounds(1, 5).setLabels('ไม่แนะนำเลย', 'แนะนำแน่นอน').setRequired(true);
  form.addParagraphTextItem().setTitle('สิ่งที่ชอบที่สุดในระบบนี้');
  form.addParagraphTextItem().setTitle('สิ่งที่ควรปรับปรุง');
  form.addParagraphTextItem().setTitle('ฟีเจอร์ที่อยากให้มีเพิ่ม');

  // เก็บคำตอบลง Google Sheets
  const sheet = SpreadsheetApp.create('คำตอบ - แบบสอบถามความพึงพอใจ Guidance KKW');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('ลิงก์แก้ไขฟอร์ม: ' + form.getEditUrl());
  Logger.log('ลิงก์ส่งให้นักเรียน: ' + form.getPublishedUrl());
  Logger.log('ไฟล์คำตอบ (Google Sheets): ' + sheet.getUrl());
}
