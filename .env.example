# Database (MariaDB 10.4, same as XAMPP)
DB_NAME=project_rm
DB_USER=app_user
DB_PASS=change_me
DB_ROOT_PASS=change_me_root

JWT_SECRET=change_me_secret

# Ports on the host machine
WEB_PORT=5173
PMA_PORT=8081
# URL people use to open the site (e.g. http://your-server-ip:5173)
CORS_ORIGIN=http://localhost:5173

# Google Login: Client ID จาก Google Cloud Console (OAuth 2.0 Client, Web application)
GOOGLE_CLIENT_ID=959939148925-edrs5iq8sbum9m7ni0nmh7j8p89flgia.apps.googleusercontent.com

# HTTPS บน server (Google Login ต้องใช้ https + ชื่อโดเมน, ใช้ IP ตรงๆ ไม่ได้)
# ไม่มีโดเมน ใช้ <ip-คั่นด้วยขีด>.sslip.io ได้ เช่น IP 1.2.3.4 -> 1-2-3-4.sslip.io
# แล้วตั้ง CORS_ORIGIN=https://<DOMAIN>
# COMPOSE_PROFILES=https
# DOMAIN=1-2-3-4.sslip.io

# ใช้ฐานข้อมูลของ XAMPP บนเครื่องแทน MariaDB ใน Docker (เฉพาะเครื่อง dev, ห้ามใช้บน server)
